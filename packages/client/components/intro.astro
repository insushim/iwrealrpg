---
import { t, getLanguage } from '@kaetram/common/i18n';

let currentLanguage = getLanguage(),
    languages = [
        { locale: 'ko', name: '한국어' },
        { locale: 'en', name: 'English' },
        { locale: 'de', name: 'Deutsch' },
        { locale: 'es', name: 'Español' },
        { locale: 'fr', name: 'Français' },
        { locale: 'pt', name: 'Português' },
        { locale: 'ro', name: 'Română' },
        { locale: 'ru', name: 'Русский' },
        { locale: 'tl', name: 'Tagalog' }
    ];
---

<div id="intro">
    <section id="parchment" class="load-character slice-menu-fancy">
        <article id="load-character">
            <h1 class="title-decoration">WordQuest Online</h1>
            <p class="subtitle">모험하며 배우는 영어 MMORPG</p>

            <form onsubmit={'return false'}>
                <input
                    type="text"
                    id="login-name-input"
                    class="stroke slice-input"
                    name="player-name"
                    placeholder="사용자 이름"
                    aria-label="사용자 이름"
                    maxlength="32"
                    autocomplete="off"
                />
                <input
                    type="password"
                    id="login-password-input"
                    class="stroke slice-input"
                    name="player-password"
                    placeholder="비밀번호"
                    aria-label="비밀번호"
                    maxlength="64"
                    autocomplete="off"
                />

                <div class="validation-summary"></div>

                <div class="button-row">
                    <label id="remember-me" class="check">
                        <input type="checkbox" aria-labelledby="remember-me-text" />
                        <span class="checkmark"></span>

                        <span id="remember-me-text">자동 로그인</span>
                    </label>
                    <label id="guest" class="check">
                        <input type="checkbox" aria-labelledby="guest-text" />
                        <span class="checkmark"></span>

                        <span id="guest-text">손님으로 플레이</span>
                    </label>
                </div>

                <div class="button-row">
                    <button
                        title="로그인"
                        aria-label="로그인"
                        type="submit"
                        id="login"
                        class="stroke slice-button"
                        disabled
                    >
                        로그인
                    </button>
                    <button
                        title="회원가입"
                        aria-label="회원가입"
                        type="button"
                        id="new-account"
                        class="stroke slice-button"
                    >
                        회원가입
                    </button>
                </div>
            </form>
        </article>

        <article id="create-character">
            <h1 class="title-decoration">새 캐릭터</h1>

            <form onsubmit={'return false'}>
                <input
                    type="text"
                    id="register-name-input"
                    class="stroke slice-input"
                    name="player-name"
                    placeholder="사용자 이름"
                    aria-label="사용자 이름"
                    maxlength="32"
                    autocomplete="off"
                />
                <input
                    type="password"
                    id="register-password-input"
                    class="stroke slice-input"
                    name="player-password"
                    placeholder="비밀번호"
                    aria-label="비밀번호"
                    maxlength="64"
                    autocomplete="off"
                />
                <input
                    type="password"
                    id="register-password-confirmation-input"
                    class="stroke slice-input"
                    name="player-password2"
                    placeholder="비밀번호 확인"
                    aria-label="비밀번호 확인"
                    maxlength="64"
                    autocomplete="off"
                />
                <input
                    type="email"
                    id="register-email-input"
                    class="stroke slice-input"
                    name="player-email"
                    placeholder="이메일 주소"
                    aria-label="이메일 주소"
                    maxlength="64"
                    autocomplete="off"
                />

                <div id="class-select">
                    <p class="class-label">클래스 선택</p>
                    <div class="class-options">
                        <label class="class-option">
                            <input type="radio" name="player-class" value="0" checked />
                            <span class="class-card">
                                <strong>⚔️ 기사</strong>
                                <small>검과 방패의 달인</small>
                            </span>
                        </label>
                        <label class="class-option">
                            <input type="radio" name="player-class" value="1" />
                            <span class="class-card">
                                <strong>🏹 요정</strong>
                                <small>활과 민첩의 달인</small>
                            </span>
                        </label>
                        <label class="class-option">
                            <input type="radio" name="player-class" value="2" />
                            <span class="class-card">
                                <strong>🔮 마법사</strong>
                                <small>마법과 지팡이의 달인</small>
                            </span>
                        </label>
                    </div>
                </div>

                <div id="study-language-select">
                    <p class="class-label">학습 언어 선택</p>
                    <div class="language-options">
                        <label class="language-option">
                            <input type="radio" name="study-language" value="english" checked />
                            <span class="class-card"><strong>🇺🇸 영어</strong></span>
                        </label>
                        <label class="language-option">
                            <input type="radio" name="study-language" value="japanese" />
                            <span class="class-card"><strong>🇯🇵 일본어</strong></span>
                        </label>
                        <label class="language-option">
                            <input type="radio" name="study-language" value="chinese" />
                            <span class="class-card"><strong>🇨🇳 중국어</strong></span>
                        </label>
                        <label class="language-option">
                            <input type="radio" name="study-language" value="french" />
                            <span class="class-card"><strong>🇫🇷 프랑스어</strong></span>
                        </label>
                        <label class="language-option">
                            <input type="radio" name="study-language" value="spanish" />
                            <span class="class-card"><strong>🇪🇸 스페인어</strong></span>
                        </label>
                        <label class="language-option">
                            <input type="radio" name="study-language" value="german" />
                            <span class="class-card"><strong>🇩🇪 독일어</strong></span>
                        </label>
                    </div>
                </div>

                <div class="validation-summary"></div>

                <div class="button-row">
                    <button
                        title="취소"
                        aria-label="취소"
                        type="button"
                        id="cancel-register"
                        class="stroke slice-button"
                    >
                        취소
                    </button>
                    <button
                        title="플레이"
                        aria-label="플레이"
                        type="submit"
                        id="play"
                        class="stroke slice-button"
                    >
                        플레이
                    </button>
                </div>
            </form>
        </article>

        <article id="reset-password">
            <h1>
                <span class="left-ornament"></span>
                 비밀번호 재설정
                <span class="right-ornament"></span>
            </h1>

            <form onsubmit={'return false'}>
                <input
                    type="text"
                    id="email-reset-input"
                    class="stroke slice-input"
                    name="player-email"
                    placeholder="이메일 주소"
                    aria-label="이메일 주소"
                    maxlength="32"
                    autocomplete="off"
                />

                <div class="validation-summary"></div>

                <div class="button-row">
                    <button
                        title="취소"
                        aria-label="취소"
                        type="button"
                        id="cancel-forget"
                        class="stroke slice-button"
                    >
                        취소
                    </button>
                    <button
                        title="제출"
                        aria-label="제출"
                        type="submit"
                        id="continue-forget"
                        class="stroke slice-button"
                    >
                        계속
                    </button>
                </div>
            </form>
        </article>

        <article id="world-select">
            <h1>
                <span class="left-ornament"></span>
                 서버 선택
                <span class="right-ornament"></span>
            </h1>

            <form onsubmit={'return false'}>
                <ol id="worlds"></ol>

                <div class="button-row">
                    <button
                        title="취소"
                        aria-label="취소"
                        type="button"
                        id="cancel-worlds"
                        class="stroke slice-button"
                    >
                        취소
                    </button>
                    <button
                        title="계속"
                        aria-label="계속"
                        type="submit"
                        id="continue-worlds"
                        class="stroke slice-button"
                    >
                        계속
                    </button>
                </div>
            </form>
        </article>

        <article id="credits">
            <h1 class="title-decoration">크레딧</h1>

            <p>
                <br />
                픽셀 아트 제작:
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://www.littleworkshop.fr/">Little Workshop</a
                >,
                <br />
                Asky Team
                <br />
                <br />
                추가 픽셀 에셋:
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://opengameart.org/users/buch">Buch</a
                >,
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://shikashiassets.itch.io/shikashis-fantasy-icons-pack">Shikashi</a
                >,
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://opengameart.org/content/kyrises-free-16x16-rpg-icon-pack"
                    >Kyrise</a
                >,
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://game-icons.net">Game-Icons.net</a
                >, Boo
                <br />
                <br />
                음악 제작:
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://soundcloud.com/gyrowolf">Terrel O'Brien</a
                >,
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://blog.dayjo.org">Joel Day</a
                >,
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://www.dantilden.com">Dan Tilden</a
                >,
                <a
                    rel="noopener noreferrer"
                    target="_blank"
                    class="clickable"
                    href="https://soundcloud.com/aaron-anderson-11">Aaron Krogh</a
                >
                <br /><br /><a rel="noopener noreferrer" class="clickable" target="_blank" href="https://kaetram.com">Kaetram-Open</a> 기반 (MPL 2.0 + OPL 라이선스)<br />교육용으로 수정됨 — WordQuest Online
            </p>

            <div class="close-about">
                <span>-- 클릭하여 닫기 --</span>
            </div>
        </article>

        <article id="about">
            <h1 class="title-decoration">소개</h1>

            <p>
                WordQuest Online은 브라우저 기반 2D MMORPG 영어 학습 게임입니다.<br />
                몬스터를 물리치고 영어 퀴즈를 풀면서 즐겁게 영어를 배워보세요!<br /><br />
                Kaetram-Open을 기반으로 한국 초등학생을 위해 제작되었으며,<br />
                오픈소스 프로젝트입니다.<br /><br />
                소스코드:
                <a target="_blank" href="https://github.com/insushim/iwrealrpg"
                    >GitHub 저장소</a
                >
            </p>

            <div class="close-about">
                <span>-- 클릭하여 닫기 --</span>
            </div>
        </article>

        <article id="git"></article>

        <article id="death">
            <h1>사망했습니다...</h1>
            <button
                title="부활"
                id="respawn"
                aria-label="부활"
                class="stroke slice-button">부활하기</button
            >
        </article>

        <span class="loader" hidden>
            접속 중<span class="loader-dot">.</span><span class="loader-dot">.</span><span
                class="loader-dot">.</span
            >
        </span>
    </section>

    <select id="lang-select" oninput={'location = "/" + this.value + "/"'}>
        {
            languages.map(({ locale, name }) => (
                <option value={locale} selected={locale === currentLanguage}>
                    {name}
                </option>
            ))
        }
    </select>

    <button id="world-select-button" class="slice-button" hidden>
        <strong class="stroke"></strong>
        <span class="stroke"></span>
    </button>

    <span id="game-version" class="version"></span>

    <footer>
        <div id="about-link" class="clickable">
            <span id="toggle-about">소개</span>
        </div>
        <span>&ndash;</span>
        <div id="credits-link" class="clickable">
            <span id="toggle-credits">크레딧</span>
        </div>
        <span>&ndash;</span>
        <div id="discord-link" class="clickable">
            <a class="footer-button" target="_blank" href="https://discord.gg/MmbGAaw">
                <span>Discord</span>
            </a>
        </div>
        <span>&ndash;</span>
        <div class="clickable">
            <a
                class="footer-button"
                target="_blank"
                href="https://www.patreon.com/bePatron?u=29287394"
            >
                <span>Patreon</span>
            </a>
        </div>
        <span>&ndash;</span>
        <div id="privacy" class="clickable">
            <a class="footer-button" href="/privacy/">
                <span>Privacy</span>
            </a>
        </div>
        <span>&ndash;</span>
        <div id="reset" class="clickable">
            <span id="toggle-reset-password">Reset Password</span>
        </div>
    </footer>
</div>
